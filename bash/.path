export EDITOR="nvim"
export PATH="$HOME/.local/bin:$PATH"
export PATH="/opt/oss-cad-suite/bin:$PATH"
export PATH="$HOME/.local/lib/synlig:$PATH"
export PATH="/opt/Surelog/bin/bin:$PATH"
export PATH="/opt/flutter/bin:$PATH"
#export PATH="$HOME/.local/riscv-rp2350/bin:$PATH"
export PATH="$HOME/.npm-global/bin:$PATH"
export ANDROID_HOME=$HOME/Android/Sdk
export PATH=$PATH:$ANDROID_HOME/tools:$ANDROID_HOME/platform-tools
export NDK_HOME="$ANDROID_HOME/ndk/$(ls -1 $ANDROID_HOME/ndk)"
#export PICO_SDK_PATH="$HOME/projects/pico/pico-sdk"
# Custom scripts
#export PATH="$PATH:$HOME/.scripts/"
# Install Ruby Gems to ~/gems
export GEM_HOME="$HOME/gems"
export PATH="$GEM_HOME/bin:$PATH"
export PATH="$HOME/.local/share/gem/ruby/3.4.0/bin:$PATH"

# >>> mamba initialize >>>
# !! Contents within this block are managed by 'mamba shell init' !!
export MAMBA_EXE='/home/sanka/miniforge3/bin/mamba'
export MAMBA_ROOT_PREFIX='/home/sanka/miniforge3'
__mamba_setup="$("$MAMBA_EXE" shell hook --shell bash --root-prefix "$MAMBA_ROOT_PREFIX" 2>/dev/null)"
if [ $? -eq 0 ]; then
  eval "$__mamba_setup"
else
  alias mamba="$MAMBA_EXE" # Fallback on help from mamba activate
fi
unset __mamba_setup
# <<< mamba initialize <<<

# >>> conda initialize >>>
# !! Contents within this block are managed by 'conda init' !!
__conda_setup="$('/home/sanka/miniforge3/bin/conda' 'shell.bash' 'hook' 2>/dev/null)"
if [ $? -eq 0 ]; then
  eval "$__conda_setup"
else
  if [ -f "/home/sanka/miniforge3/etc/profile.d/conda.sh" ]; then
    . "/home/sanka/miniforge3/etc/profile.d/conda.sh"
  else
    export PATH="/home/sanka/miniforge3/bin:$PATH"
  fi
fi
unset __conda_setup
# <<< conda initialize <<<

